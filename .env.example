# Direct /v/ and /c/ links work without Redis. Tracked /s/ links require one
# complete variable pair below. Never commit real credentials.

# Direct Upstash setup (preferred names)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Marketplace compatibility names (alternative to the pair above)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Sponsor tiles beside the homepage on wide screens. Off unless set to "on".
# Read at build time, so redeploy (or restart the dev server) after changing.
# NEXT_PUBLIC_SPONSORS=on
